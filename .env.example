# n8n CLI Environment Variables Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to git - it contains sensitive API keys!

# n8n API Keys (get these from your n8n instance Settings → API Keys)
N8N_DEV_API_KEY=n8n_api_your_development_key_here
N8N_STAGING_API_KEY=n8n_api_your_staging_key_here
N8N_PROD_API_KEY=n8n_api_your_production_key_here

# n8n Instance URLs
N8N_DEV_URL=https://n8n-dev.yourcompany.com
N8N_STAGING_URL=https://n8n-staging.yourcompany.com
N8N_PROD_URL=https://n8n-prod.yourcompany.com

# GitLab Configuration (for CI/CD integration)
GITLAB_TOKEN=glpat-your_gitlab_personal_access_token_here
GITLAB_PROJECT_ID=12345

# CLI Configuration
N8N_CLI_LANG=en  # Language: en (English) or es (Spanish)

# Optional: Notification Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
TEAMS_WEBHOOK_URL=https://yourcompany.webhook.office.com/webhookb2/YOUR/TEAMS/WEBHOOK

# Optional: Email Notifications
EMAIL_SMTP_HOST=smtp.yourcompany.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=notifications@yourcompany.com
EMAIL_PASSWORD=your_email_password_here