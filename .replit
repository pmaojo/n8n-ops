modules = ["go", "golang"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Go CLI Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "n8n-ops Version"

[[workflows.workflow]]
name = "Go CLI Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "go run main.go --help"

[[workflows.workflow]]
name = "n8n-ops Version"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./n8n-ops version"

[deployment]
deploymentTarget = "cloudrun"
