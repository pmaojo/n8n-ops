modules = ["go"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Go CLI Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "OPS Test"

[[workflows.workflow]]
name = "Go CLI Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "go run main.go --help"

[[workflows.workflow]]
name = "OPS Test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./n8n-ops --help"

[deployment]
deploymentTarget = "cloudrun"
